{
  "manifest_version": 3,
  "name": "Prime Rating Glow",
  "version": "0.1.0",
  "description": "Glows Prime Video tiles from red to green by IMDb rating, using a local dataset or OMDb.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://*.amazon.co.uk/*",
    "https://datasets.imdbws.com/*",
    "https://www.omdbapi.com/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.amazon.co.uk/gp/video/*"
      ],
      "js": [
        "src/content/bootstrap.js"
      ],
      "css": [
        "src/content/glow.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/content/*",
        "src/shared/*"
      ],
      "matches": [
        "https://*.amazon.co.uk/*"
      ]
    }
  ],
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Prime Rating Glow"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
